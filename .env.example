# Copy to .env and fill in. Never commit .env.

# API server
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Amazon Bedrock
AWS_REGION=ap-southeast-2
# Model or inference profile ID enabled in your account (see Bedrock console > Model access)
BEDROCK_MODEL_ID=

# Credentials: prefer `aws sso login` with a named profile over static access keys
# AWS_PROFILE=your-sso-profile
